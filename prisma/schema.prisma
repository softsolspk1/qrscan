generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Doctor {
  id          String   @id @default(cuid())
  name        String
  city        String
  photoPath   String?
  scans       Int      @default(0)
  lastScanned DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([city])
}
